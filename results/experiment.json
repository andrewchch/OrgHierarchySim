  "scenarios": {
    "baseline": {
      "label": "Career ladder + competition",
      "description": "Workers value promotion prospects, firms use retention promotions, and output markets are competitive."
    },
    "no_ladder": {
      "label": "No career-ladder preference",
      "description": "Identical economy, but workers place no value on promotion prospects and will not trade wages for a ladder. Retention promotions are off."
    },
    "no_competition": {
      "label": "Sheltered market",
      "description": "Fixed output price and very little firm failure. Inefficient hierarchies are allowed to persist."
    },
    "high_competition": {
      "label": "High competitive pressure",
      "description": "A more contested output market, lower prices, easier entry, and a tighter failure threshold."
    }
  },
